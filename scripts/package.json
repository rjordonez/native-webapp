{
  "name": "teacher-reports-processor",
  "version": "1.0.0",
  "description": "Scripts to process and check teacher reports",
  "main": "processTeacherReports.ts",
  "scripts": {
    "check": "ts-node checkPendingReports.ts",
    "check:zero": "ts-node checkPendingReports.ts --0",
    "start": "ts-node processTeacherReports.ts",
    "check:missing-analysis": "ts-node checkMissingAnalysis.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.5.0",
    "axios": "^1.6.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
